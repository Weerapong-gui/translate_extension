{
  "manifest_version": 3,
  "name": "Star Sky New Tab",
  "version": "1.0.0",
  "description": "Replaces the New Tab page with an animated starfield: twinkling stars and shooting stars on a black background.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "theme": {
    "colors": {
      "frame": [0, 0, 0],
      "frame_inactive": [0, 0, 0],
      "toolbar": [0, 0, 0],
      "toolbar_text": [255, 255, 255],
      "tab_text": [255, 255, 255],
      "tab_background_text": [200, 200, 200],
      "bookmark_text": [255, 255, 255],
      "ntp_background": [0, 0, 0],
      "ntp_text": [255, 255, 255]
    }
  }
}
